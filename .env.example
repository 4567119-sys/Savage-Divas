# Royal Square Financial - AI Document Extractor Configuration

# Optional: Google Gemini API Key for multimodal extraction (PDF/Images)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server settings
HOST=0.0.0.0
PORT=8000

# AI Model settings (gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Fallback to local heuristic extractor if Gemini API key is missing or fails
ENABLE_LOCAL_FALLBACK=true

# Minimum confidence threshold for warning flags (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.65
